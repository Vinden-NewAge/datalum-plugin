{
  "description": "Controles del cliente para Datalum: comprueban que la elección de agente y los borrados los pidió la persona, mantienen cada llamada en el agente de su conversación, piden la vista previa antes de aplicar, evitan repetir una escritura ya confirmada y recuperan el estado tras una compactación. Sólo actúan sobre las herramientas de Datalum.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/client/adapters/claude-code.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Dd]atalum.*__.*|mcp__.*__(list_agents|use_agent|release_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/client/adapters/claude-code.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*[Dd]atalum.*__.*|mcp__.*__(list_agents|use_agent|release_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/client/adapters/claude-code.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*[Dd]atalum.*__.*|mcp__.*__(list_agents|use_agent|release_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/client/adapters/claude-code.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
