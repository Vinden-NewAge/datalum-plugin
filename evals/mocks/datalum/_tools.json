       "type": "string"
      },
      "minItems": 1,
      "maxItems": 16
     },
     "group_by": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "filters": {
      "type": [
       "object",
       "array"
      ]
     },
