         "type": "string"
        }
       },
       "required": [
        "kind",
        "title"
       ],
       "additionalProperties": false
      }
     },
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "required": [
