{
 "tools": [
  {
   "name": "list_agents",
   "description": "Devuelve los agentes que el administrador otorgó a esta persona y que están en servicio. Si hay varios, pregunta a la persona con cuál quiere trabajar antes de llamar use_agent; si hay uno solo, dile cuál es y úsalo. Si la lista viene vacía, `message` explica por qué. Sólo lectura.",
   "inputSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
   }
  },
  {
   "name": "use_agent",
   "description": "Pone a esta conversación a trabajar con un agente de la lista. Llámalo cuando la persona haya dicho con cuál trabaja y pasa sus palabras tal cual en `user_choice_quote`. Devuelve la misión del agente (límites, reglas y persona, completos), el índice de su cerebro, los conectores que alcanza, las herramientas retiradas para él y `selection_context`, que hay que mandar en cada llamada siguiente. Volver a llamarlo con el mismo agente es volver a elegirlo y toma su última versión guardada: hazlo sólo cuando la persona lo pida. Para cambiar de agente, primero release_agent.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "agent": {
      "type": "string",
      "description": "Id o nombre del agente, tal como lo devolvió list_agents."
     },
     "user_choice_quote": {
      "type": "string",
      "description": "Las palabras textuales con las que la persona eligió el agente."
     },
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "required": [
     "agent",
     "user_choice_quote"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "release_agent",
   "description": "Deja a esta conversación sin agente, para cambiar de agente o para terminar.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "additionalProperties": false
   }
  },
  {
   "name": "brain_index",
   "description": "Lista un nivel del cerebro del agente o del modelo de un conector: una línea por documento con su `concept_id`. Si no cabe entero trae `next_cursor` para seguir. No devuelve cuerpos.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "tenant": {
      "type": "string",
      "description": "Slug del conector."
     },
     "path": {
      "type": "string",
      "description": "Rama a listar."
     },
     "cursor": {
      "type": "string",
      "description": "Continuación: usa el `next_cursor` que devolvió la llamada anterior."
     },
     "limit": {
      "type": "integer"
     },
     "mode": {
      "type": "string",
      "enum": [
       "full",
       "light"
      ]
     },
     "version": {
      "type": "integer"
     },
     "unit": {
      "type": "string"
     },
     "locale": {
      "type": "string",
      "enum": [
       "es",
       "en"
      ]
     },
     "include_drafts": {
      "type": "boolean"
     },
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "required": [],
    "additionalProperties": false
   }
  },
  {
   "name": "brain_read",
   "description": "Abre un documento por su `concept_id`. El cuerpo tiene tope de tamaño: si no cabe, la respuesta trae `next_offset` para continuar. Un documento por llamada.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "tenant": {
      "type": "string",
      "description": "Slug del conector."
     },
     "concept_id": {
      "type": "string",
      "description": "Identificador del documento, copiado de brain_index."
     },
     "offset": {
      "type": "integer",
      "description": "Continuación: usa el `next_offset` que devolvió la lectura anterior."
     },
     "max_bytes": {
      "type": "integer",
      "description": "Tope de bytes del cuerpo en esta lectura (por defecto 8192, máximo 32768)."
     },
     "mode": {
      "type": "string",
      "enum": [
       "full",
       "light"
      ]
     },
     "version": {
      "type": "integer"
     },
     "unit": {
      "type": "string"
     },
     "locale": {
      "type": "string",
      "enum": [
       "es",
       "en"
      ]
     },
     "include_drafts": {
      "type": "boolean"
     },
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "required": [
     "concept_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "list_memories",
   "description": "Índice de las memorias de esta persona con el agente activo, una línea por memoria. Si no cabe trae `next_cursor`. Con `memory` devuelve una memoria entera.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "preferencia",
       "hecho",
       "avance",
       "episodio"
      ]
     },
     "cursor": {
      "type": "string",
      "description": "Continuación: usa el `next_cursor` que devolvió la llamada anterior."
     },
     "memory": {
      "type": "string",
      "description": "Id o nombre de una memoria."
     },
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "additionalProperties": false
   }
  },
  {
   "name": "remember",
   "description": "Guarda una memoria personal sobre el agente activo. `kind` es preferencia, hecho, avance o episodio. Un avance lleva su lista de pasos bajo '# Pasos'. Escribir con el `slug` de una memoria existente la reemplaza. Con `scope: compartida` no se guarda: queda como propuesta para que una persona la apruebe.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "preferencia",
       "hecho",
       "avance",
       "episodio"
      ]
     },
     "title": {
      "type": "string"
     },
     "body_md": {
      "type": "string"
     },
     "slug": {
      "type": "string",
      "description": "Nombre de la memoria. Reusar un nombre reemplaza la memoria que lo tenía."
     },
     "scope": {
      "type": "string",
      "enum": [
       "personal",
       "compartida"
      ],
      "description": "'personal' (por defecto) o 'compartida'."
     },
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "required": [
     "kind",
     "title",
     "body_md"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "forget",
   "description": "Retira una memoria de esta persona. Su archivo se conserva marcado como retirado.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "memory": {
      "type": "string",
      "description": "Id o nombre de una memoria."
     },
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "required": [
     "memory"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "delete_my_memories",
   "description": "Borra para siempre todas las memorias de esta persona con el agente activo. Exige `confirm: true` y las palabras textuales de la persona en `user_request_quote`.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "confirm": {
      "type": "boolean",
      "description": "Con true aplica; sin él sólo previsualiza."
     },
     "user_request_quote": {
      "type": "string",
      "description": "Las palabras textuales con las que la persona pidió el borrado."
     },
     "selection_context": {
      "type": "string",
      "description": "El identificador de esta conversación que devolvió use_agent. Mándalo en cada llamada."
     }
    },
    "required": [
     "confirm",
     "user_request_quote"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "brain_write",
   "description": "Crea una memoria por su ruta en el cerebro del agente, o un agente nuevo en borrador.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "concept_id": {
      "type": "string",
      "description": "Identificador del documento, copiado de brain_index."
     },
     "title": {
      "type": "string"
     },
     "body_md": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "preferencia",
       "hecho",
       "avance",
       "episodio"
      ]
     },
     "scope": {
      "type": "string",
      "enum": [
       "personal",
       "compartida"
      ],
      "description": "'personal' (por defecto) o 'compartida'."
     },
     "tagline": {
      "type": "string"
     },
     "documents": {
      "type": "array",
