       "semester",
       "year"
      ]
     },
     "order_by": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "column": {
         "type": "string"
        },
        "direction": {
         "type": "string",
         "enum": [
          "asc",
          "desc"
         ]
        }
       },
       "required": [
        "column",
        "direction"
       ],
       "additionalProperties": false
      }
     },
     "limit": {
      "type": "integer",
      "minimum": 1
     },
     "cursor": {
      "type": "string",
